{
  "name": "@hollis-labs/kit-dashboard",
  "version": "0.1.0",
  "description": "Kit Dashboard \u2014 the dashboard idiom: shell components, layout presets, DataTable, filters, widgets and charts. Forked from @hollis-labs/sysop-ui 0.9.0.",
  "keywords": [
    "react",
    "sysop",
    "ui",
    "design-system",
    "tailwind",
    "operations"
  ],
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollis-labs/design-kit.git",
    "directory": "packages/kit-dashboard"
  },
  "homepage": "https://github.com/hollis-labs/design-kit/tree/main/packages/kit-dashboard#readme",
  "bugs": {
    "url": "https://github.com/hollis-labs/design-kit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/src/ui.d.ts",
      "import": "./dist/ui.js"
    },
      "./layout": {
      "types": "./dist/src/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./data": {
      "types": "./dist/src/data.d.ts",
      "import": "./dist/data.js"
    },
    "./widgets": {
      "types": "./dist/src/widgets.d.ts",
      "import": "./dist/widgets.js"
    },
    "./charts": {
      "types": "./dist/src/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./theme.css": "./src/styles/theme.css",
    "./source.css": "./src/styles/source.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@hollis-labs/design-app-runtime": "^0.1.0",
    "@hollis-labs/design-components": "^0.1.0",
    "@hollis-labs/design-tokens": "^0.1.0",
    "lucide-react": "^1.7.0",
    "recharts": "^3.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.3.0",
    "@eslint/js": "^9.39.4",
    "shadcn": "^4.2.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@tailwindcss/vite": "^4.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9"
  }
}
