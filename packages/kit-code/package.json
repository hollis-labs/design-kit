{
  "name": "@hollis-labs/kit-code",
  "version": "0.0.0",
  "description": "Code and developer presentation components; highlighting and ANSI rendering are opt-in.",
  "keywords": [
    "react",
    "code",
    "design-system"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollis-labs/design-kit.git",
    "directory": "packages/kit-code"
  },
  "homepage": "https://github.com/hollis-labs/design-kit/tree/main/packages/kit-code#readme",
  "bugs": {
    "url": "https://github.com/hollis-labs/design-kit/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./source.css": "./src/styles/source.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "@base-ui/react": "^1.3.0",
    "lucide-react": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.5.0",
    "ansi-to-react": "^6.2.6"
  },
  "dependencies": {
    "@hollis-labs/design-components": "^0.3.0",
    "@hollis-labs/design-tokens": "^0.3.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.3.0",
    "@eslint/js": "^9.39.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~6.0.2",
    "vite": "5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9",
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "typescript-eslint": "^8.58.0",
    "shiki": "^4.5.0",
    "ansi-to-react": "^6.2.6"
  },
  "private": true,
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    },
    "ansi-to-react": {
      "optional": true
    }
  }
}
