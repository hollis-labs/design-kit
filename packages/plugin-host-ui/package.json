{
  "name": "@hollis-labs/plugin-host-ui",
  "version": "0.1.0",
  "description": "Host-neutral plugin rendering, configuration and Vite provisioning.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "source.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./source.css": "./source.css",
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollis-labs/design-kit.git",
    "directory": "packages/plugin-host-ui"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && vitest run",
    "test:run": "npm run build && vitest run",
    "prepack": "npm run build",
    "lint": "eslint .",
    "example:build": "npm run build && vite build --config examples/importmap-host/vite.config.ts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "example:render:build": "npm run build && vite build --config examples/render-host/vite.config.ts"
  },
  "peerDependencies": {
    "vite": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@hollis-labs/kit-settings": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "typescript": "~6.0.2",
    "react": "^19.2.4",
    "eslint": "^9.39.4",
    "@eslint/js": "^9.39.4",
    "typescript-eslint": "^8.58.0",
    "globals": "^17.4.0",
    "@hollis-labs/eslint-config-design": "^0.4.0",
    "react-dom": "^19.2.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^25.0.1",
    "@hollis-labs/kit-settings": "^0.2.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "private": true,
  "dependencies": {
    "@hollis-labs/design-components": "^0.4.0",
    "@hollis-labs/design-tokens": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@hollis-labs/kit-settings": {
      "optional": true
    }
  }
}
