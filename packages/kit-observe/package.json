{
  "name": "@hollis-labs/kit-observe",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Controlled read-only health, stats, sample series and diagnostic evidence; host-owned data and transport.",
  "keywords": [
    "react",
    "observe",
    "design-system"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollis-labs/design-kit.git",
    "directory": "packages/kit-observe"
  },
  "homepage": "https://github.com/hollis-labs/design-kit/tree/main/packages/kit-observe#readme",
  "bugs": {
    "url": "https://github.com/hollis-labs/design-kit/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./source.css": "./src/styles/source.css",
    "./charts": {
      "types": "./dist/src/charts.d.ts",
      "import": "./dist/charts.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "@base-ui/react": "^1.3.0",
    "lucide-react": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@hollis-labs/kit-dashboard": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@hollis-labs/kit-dashboard": {
      "optional": true
    }
  },
  "dependencies": {
    "@hollis-labs/design-components": "^0.3.0",
    "@hollis-labs/design-tokens": "^0.3.0"
  },
  "devDependencies": {
    "@hollis-labs/kit-dashboard": "^0.3.0",
    "@base-ui/react": "^1.3.0",
    "@eslint/js": "^9.39.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~6.0.2",
    "vite": "5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9",
    "@tailwindcss/vite": "^4.0.0"
  }
}
