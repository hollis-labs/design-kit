{
  "name": "@hollis-labs/kit-chat",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Chat kit \u2014 ChatInput and ChatStream. Props down, messages up: no stores, no transport, no opinion about where messages come from.",
  "keywords": [
    "react",
    "chat",
    "design-system",
    "base-ui",
    "streaming",
    "composer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollis-labs/design-kit.git",
    "directory": "packages/kit-chat"
  },
  "homepage": "https://github.com/hollis-labs/design-kit/tree/main/packages/kit-chat#readme",
  "bugs": {
    "url": "https://github.com/hollis-labs/design-kit/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/src/markdown/index.d.ts",
      "import": "./dist/markdown/index.js"
    },
    "./markdown.css": "./src/styles/markdown.css",
    "./source.css": "./src/styles/source.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.3.0",
    "lucide-react": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "streamdown": "^2.6.0"
  },
  "peerDependenciesMeta": {
    "streamdown": {
      "optional": true
    }
  },
  "dependencies": {
    "@hollis-labs/design-bindings": "^0.1.0",
    "@hollis-labs/design-components": "^0.1.0",
    "@hollis-labs/design-tokens": "^0.1.0",
    "@shadcn/react": "^0.3.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.3.0",
    "@eslint/js": "^9.39.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "streamdown": "^2.6.0",
    "typescript": "~6.0.2",
    "vite": "5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9"
  }
}
