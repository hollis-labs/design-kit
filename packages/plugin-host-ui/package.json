{
  "name": "@hollis-labs/plugin-host-ui",
  "version": "0.1.0",
  "description": "Host-neutral plugin UI provisioning and Vite importmap helper.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollis-labs/design-kit.git",
    "directory": "packages/plugin-host-ui"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && vitest run",
    "test:run": "npm run build && vitest run",
    "prepack": "npm run build",
    "lint": "eslint .",
    "example:build": "npm run build && vite build --config examples/importmap-host/vite.config.ts",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "typescript": "~6.0.2",
    "react": "^19.2.4",
    "eslint": "^9.39.4",
    "@eslint/js": "^9.39.4",
    "typescript-eslint": "^8.58.0",
    "globals": "^17.4.0",
    "@hollis-labs/eslint-config-design": "^0.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "private": true
}
